services:
  maintainerr:
    labels:
      - "cloud.hutter.docker-compose={{ compose_file_reference }}"
      - "traefik.enable=true"
      - "traefik.http.routers.maintainerr.rule=Host(`maintainerr.hutter.cloud`)"
      - "traefik.http.routers.maintainerr.entrypoints=websecure"
      - "traefik.http.routers.maintainerr.service=maintainerr"
      - "traefik.http.routers.maintainerr.tls=true"
      - "traefik.http.routers.maintainerr.tls.certresolver=r53"
      - "traefik.http.routers.maintainerr.middlewares=oauth-errors@docker,oauth@docker"
      - "traefik.http.services.maintainerr.loadbalancer.server.port=6246"
    container_name: maintainerr
    image: {{ image }}
    user: "1000:1000"
    environment:
      TZ: "Europe/Zurich"
    networks:
      - bridge
    volumes:
      - "{{ bind_dir_config }}:/opt/data"
    restart: unless-stopped
networks:
  bridge:
    name: "{{ network }}"
    external: true
